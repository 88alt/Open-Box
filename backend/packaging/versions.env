# 随包组件的版本、来源与校验和(M6 第六节)。
#
# 只放「构建时钉死的输入」,不放任何路径:路径由各脚本自己算。
# 每个下载的输入都写了 sha256,对不上就失败,不允许「下到了就用」。
#
# 两个内核都必须用**打过 open-box 补丁**的源码,不能用 SagerNet / MetaCubeX 的官方二进制:
#   - sing-box:配置里有 node_score_weights、bandwidth、以及 openbox-* 系列字段,原版内核会因未知字段启动失败;
#   - Mihomo:配置里有 openbox-* 补丁键,原版会忽略,功能就不全(见 STATUS 双内核第 3e 步)。
# 上游把这些补丁源码作为 release 资产公开(open-box 仓库的 release),所以可以自己编,不依赖闭源产物。
# 内核版本随上游 release 变,换版本时连 KERNEL_SOURCE_BASE 一起改。

# 上游号:与 catch-up-upstream 上对齐的那个 release 一致
OPENBOX_UPSTREAM=492

# 内核补丁源码的下载前缀(上游 release 的资产地址)。上游发新版时改这里。
KERNEL_SOURCE_BASE="https://github.com/timeflysoon/Open-Box/releases/download/v0.1.492"

# ---- sing-box(魔改)----
SINGBOX_VERSION=1.14.4
SINGBOX_PATCH=openbox-61
# 打进二进制 constant.Version 的字符串,`sing-box version` 与面板概览顶栏都读它
SINGBOX_BUILD_VERSION="${SINGBOX_VERSION}-${SINGBOX_PATCH}"
SINGBOX_SOURCE_ASSET="sing-box-${SINGBOX_VERSION}-${SINGBOX_PATCH}-source.tar.gz"
SINGBOX_SOURCE_SHA256=9191eecce955a8f8158637a7cd3564966ac9309843a0c71cca0e7df18b1ff32c
# 源码包解出来的顶层目录
SINGBOX_SOURCE_DIR=source-bundle
# 构建标签不写死:从源码包的 release/DEFAULT_BUILD_TAGS_OTHERS 读(构建脚本自己读),
# 这样上游改了标签清单我们不用跟着改。

# ---- Mihomo(魔改)----
MIHOMO_VERSION=v1.19.34
MIHOMO_PATCH=openbox.23
MIHOMO_BUILD_VERSION="${MIHOMO_VERSION}-${MIHOMO_PATCH}"
MIHOMO_SOURCE_ASSET="mihomo-${MIHOMO_VERSION}-${MIHOMO_PATCH}-source.tar.gz"
MIHOMO_SOURCE_SHA256=8470e20c37673e3fc56b08ce83da78988fe73fdd33103d215d5dbdc1f42d2cd7
MIHOMO_SOURCE_DIR="mihomo-${MIHOMO_VERSION}-${MIHOMO_PATCH}"

# ---- 规则库 ----
# M6 第十二节第 4 条:来源与许可要维护者核对,核对之前默认不随包。
# 上游把规则库源码打成一个固定提交的资产,核过许可后把 INCLUDE_GEODATA 改成 1 即可。
INCLUDE_GEODATA=0
GEODATA_REF=287ca45a8e93506f666f0e72f934457e52397fb1
GEODATA_SOURCE_ASSET="geodata-${GEODATA_REF}-sources.tar.xz"
GEODATA_SOURCE_SHA256=7aac9583c7c8619e9c7e05528f8765c2b7e858dd10a36c952b0e27a7ad5664c9
# 随包的分类清单(空格分隔,不带 .srs 后缀)。只有 INCLUDE_GEODATA=1 时才有意义。
GEODATA_SERIES="geosite-cn geoip-cn"
