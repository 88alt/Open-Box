#!/bin/sh /etc/rc.common
# Open-Box 后端(自研 backend)的 procd 脚本。安装到 /etc/init.d/openbox-backend。
#
# 为什么服务名不叫 openbox:上游同步来的 /etc/init.d/openbox 是内核服务(openwrt/initd/openbox),
# 不能占。后端用 -core-service openbox 去控制它,两边不冲突。
# START / STOP 与上游面板服务(openwrt/initd/openbox-panel 的 98 / 11)一致。
#
# 卸载时后端要先自己 cleanup(撤销 DNS 接管、停内核、拆虚拟终端)再被删,见 openbox-backend cleanup 子命令;
# 那是卸载脚本的调用顺序,与这里的 start / stop 无关。

USE_PROCD=1
START=98
STOP=11

OPENBOX_ROOT=/opt/open-box
RUN="$OPENBOX_ROOT/bin/openbox-backend-run"

start_service() {
	[ -x "$RUN" ] || {
		echo "openbox-backend: 找不到 $RUN" >&2
		return 1
	}
	procd_open_instance openbox-backend
	procd_set_param command "$RUN"
	procd_set_param stdout 1
	procd_set_param stderr 1
	# 与上游面板服务同一组 respawn 参数:3600 秒内最多重试 5 次,0 = 不限总次数
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
