#!/bin/sh
# openbox-panel.service 的 ExecStart:算好端口再 exec 纯静态 Go 面板 openbox-panel,
# 对应 OpenWrt 脚本 openwrt/initd/openbox-panel 的 start_service。
OPENBOX_ROOT=/opt/open-box
PANEL_BIN="$OPENBOX_ROOT/bin/openbox-panel"
DATA="$OPENBOX_ROOT/data"

if [ ! -x "$PANEL_BIN" ]; then
	echo "openbox-panel: binary not found at $PANEL_BIN" >&2
	exit 1
fi
mkdir -p "$DATA"

# 命令行 open-box(看面板密码 / 检查升级):Debian 放 /usr/local/bin,每次启动补一次软链接,不覆盖别人的真文件
if [ -f "$OPENBOX_ROOT/openwrt/bin/open-box" ] && { [ ! -e /usr/local/bin/open-box ] || [ -L /usr/local/bin/open-box ]; }; then
	chmod +x "$OPENBOX_ROOT/openwrt/bin/open-box" 2>/dev/null
	ln -sf "$OPENBOX_ROOT/openwrt/bin/open-box" /usr/local/bin/open-box 2>/dev/null
fi

# 面板端口的算法和 OpenWrt 脚本一致(data/panel-port 没有就是 2026)
panel_port=$(cat "$DATA/panel-port" 2>/dev/null | tr -dc '0-9')
[ -n "$panel_port" ] || panel_port=2026

# HOST=:: 双栈(GitHub #276,没开 IPv6 时面板自己退回 0.0.0.0)
export PORT="$panel_port" HOST=:: OPENBOX_ROOT="$OPENBOX_ROOT" \
	ZASHBOARD_DB_PATH="$DATA/openbox.sqlite" OPENBOX_PLATFORM=systemd
unset LD_LIBRARY_PATH
unset LD_PRELOAD
exec "$PANEL_BIN" serve
