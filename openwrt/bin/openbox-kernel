#!/bin/sh
# Resolve the router's persisted kernel selection for each service start.
openbox_kernel_paths() {
	OPENBOX_KERNEL=sing-box
	if [ -f "$OPENBOX_ROOT/etc/router-kernel" ]; then
		OPENBOX_KERNEL=$(cat "$OPENBOX_ROOT/etc/router-kernel") || return 1
	fi
	case "$OPENBOX_KERNEL" in
		sing-box)
			BIN="$OPENBOX_ROOT/bin/sing-box"
			CONF="$OPENBOX_ROOT/etc/config.json"
			KERNEL_HOME="$OPENBOX_ROOT/data"
			;;
		mihomo)
			BIN="$OPENBOX_ROOT/bin/mihomo"
			CONF="$OPENBOX_ROOT/etc/mihomo.yaml"
			KERNEL_HOME="$OPENBOX_ROOT/data/mihomo"
			;;
		*)
			echo 'openbox: invalid router kernel selection' >&2
			return 1
			;;
	esac
}

openbox_kernel_ready() {
	openbox_kernel_paths || return 1
	[ -x "$BIN" ] || { echo "openbox: kernel binary not found at $BIN" >&2; return 1; }
	[ -s "$CONF" ] || { echo "openbox: config not found at $CONF" >&2; return 1; }
}

openbox_kernel_mem_env() {
	OPENBOX_KERNEL_GOMEMLIMIT="${GOMEMLIMIT:-}"
	OPENBOX_KERNEL_GOGC="${GOGC:-}"
	[ -n "$OPENBOX_KERNEL_GOMEMLIMIT" ] && return 0

	_ob_meminfo=${OPENBOX_MEMINFO_PATH:-/proc/meminfo}
	_ob_cg_root=${OPENBOX_CGROUP_ROOT:-/sys/fs/cgroup}
	_ob_mem_kb=$(awk '/^MemTotal:/ {print $2}' "$_ob_meminfo" 2>/dev/null)
	for _ob_cg in "$_ob_cg_root/memory.max" "$_ob_cg_root/memory/memory.limit_in_bytes" "$_ob_cg_root/memory.limit_in_bytes"; do
		[ -r "$_ob_cg" ] || continue
		_ob_cg_kb=$(awk '$1 ~ /^[0-9]+$/ && $1 > 0 && $1 < 1125899906842624 {printf "%.0f", $1 / 1024}' "$_ob_cg" 2>/dev/null)
		if [ -n "$_ob_cg_kb" ] && [ "$_ob_cg_kb" -gt 0 ]; then
			if [ -z "$_ob_mem_kb" ] || [ "$_ob_cg_kb" -lt "$_ob_mem_kb" ]; then
				_ob_mem_kb="$_ob_cg_kb"
			fi
		fi
	done
	case "$_ob_mem_kb" in
		''|*[!0-9]*) return 0 ;;
	esac
	[ "$_ob_mem_kb" -gt 0 ] || return 0

	case "${OPENBOX_KERNEL:-sing-box}" in
		mihomo)
			if [ "$_ob_mem_kb" -lt 393216 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=96MiB; _ob_default_gogc=30
			elif [ "$_ob_mem_kb" -lt 786432 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=144MiB; _ob_default_gogc=40
			elif [ "$_ob_mem_kb" -lt 1572864 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=224MiB; _ob_default_gogc=50
			elif [ "$_ob_mem_kb" -lt 3145728 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=320MiB; _ob_default_gogc=60
			else
				OPENBOX_KERNEL_GOMEMLIMIT=512MiB; _ob_default_gogc=75
			fi
			;;
		*)
			if [ "$_ob_mem_kb" -lt 393216 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=72MiB; _ob_default_gogc=35
			elif [ "$_ob_mem_kb" -lt 786432 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=112MiB; _ob_default_gogc=50
			elif [ "$_ob_mem_kb" -lt 1572864 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=176MiB; _ob_default_gogc=60
			elif [ "$_ob_mem_kb" -lt 3145728 ]; then
				OPENBOX_KERNEL_GOMEMLIMIT=256MiB; _ob_default_gogc=75
			else
				OPENBOX_KERNEL_GOMEMLIMIT=384MiB; _ob_default_gogc=80
			fi
			;;
	esac
	[ -n "$OPENBOX_KERNEL_GOGC" ] || OPENBOX_KERNEL_GOGC="$_ob_default_gogc"
}

openbox_kernel_exec() {
	openbox_kernel_ready || return 1
	openbox_kernel_mem_env
	[ -n "$OPENBOX_KERNEL_GOMEMLIMIT" ] && export GOMEMLIMIT="$OPENBOX_KERNEL_GOMEMLIMIT"
	[ -n "$OPENBOX_KERNEL_GOGC" ] && export GOGC="$OPENBOX_KERNEL_GOGC"
	case "$OPENBOX_KERNEL" in
		mihomo)
			if [ -s "$OPENBOX_ROOT/etc/mihomo-entry-bypass.nft" ]; then
				export OPENBOX_MIHOMO_ENTRY_BYPASS=1
			fi
			exec "$BIN" -d "$KERNEL_HOME" -f "$CONF"
			;;
		sing-box) exec "$BIN" run -c "$CONF" -D "$KERNEL_HOME" ;;
	esac
}

if [ "${0##*/}" = openbox-kernel ]; then
	OPENBOX_ROOT=/opt/open-box
	openbox_kernel_exec
fi
